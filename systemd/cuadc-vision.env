# 选择数字或图案飞行任务。
VISION_TASK=digit

# 配置飞控连接和目标平面高度。
MAVLINK_ENDPOINT=/dev/serial0
MAVLINK_BAUD=57600
HEIGHT_SOURCE=relative-alt
TARGET_PLANE_ALTITUDE_ABOVE_HOME_M=0

# 配置相机相对飞控导航原点的FRD安装位姿。
CAMERA_MOUNT_ROLL=0
CAMERA_MOUNT_PITCH=0
CAMERA_MOUNT_YAW=0
CAMERA_OFFSET_FORWARD_M=0
CAMERA_OFFSET_RIGHT_M=0
CAMERA_OFFSET_DOWN_M=0
